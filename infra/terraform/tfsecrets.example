# Copy this file to `infra/terraform/tfsecrets` for owner-run local/staging work.
# The real file is ignored by Git. Use sandbox/test credentials only.
# Never paste real values into commits, PRs, logs, plans, artifacts, or prompts.

TF_VAR_cj_api_key=replace-with-cj-sandbox-value
TF_VAR_stripe_secret_key=replace-with-stripe-test-value
TF_VAR_stripe_webhook_secret=replace-with-stripe-test-webhook-value
TF_VAR_elevenlabs_api_key=replace-with-non-production-value
TF_VAR_google_oauth_client_secret=replace-with-staging-value
TF_VAR_turnstile_secret_key=replace-with-staging-value

# Add new keys only after the corresponding sensitive Terraform variable is
# reviewed. This file documents names, not production secret values.
