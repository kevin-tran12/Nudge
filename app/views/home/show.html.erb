<% content_for :title, "Nudge" %>

<section class="relative isolate overflow-hidden">
  <div class="absolute inset-x-0 top-0 -z-10 h-72 bg-gradient-to-b from-brand-100/70 to-transparent" aria-hidden="true"></div>

  <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2 lg:items-center lg:gap-16 lg:px-8 lg:py-28">
    <div class="max-w-2xl">
      <%= render "shared/badge", label: "Thoughtful shopping support", tone: :brand %>
      <h1 class="mt-6 font-display text-4xl font-bold leading-tight tracking-tight text-ink sm:text-5xl lg:text-6xl">
        Find the right fit for everyday life.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-muted">
        Nudge helps turn what you need into clear choices, with the details and tradeoffs kept in view.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <%= render "shared/button", label: "See how Nudge helps", href: "#how-it-works", variant: :primary %>
        <%= render "shared/button", label: "Learn about our approach", href: "#our-approach", variant: :secondary %>
      </div>
    </div>

    <div class="rounded-card border border-line bg-surface p-5 shadow-card sm:p-8">
      <p class="text-sm font-bold uppercase tracking-widest text-brand-700">Made for real decisions</p>
      <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <%= render "shared/card", title: "A calmer home", body: "Start with the outcome you want, even when you do not know the product name.", eyebrow: "Home organization" %>
        <%= render "shared/card", title: "Care that fits", body: "Keep practical needs visible while you weigh choices for your pets.", eyebrow: "Pet supplies" %>
      </div>
    </div>
  </div>
</section>

<section id="how-it-works" class="scroll-mt-24 border-y border-line bg-surface">
  <div class="mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <div class="max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-widest text-brand-700">How it works</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">A clearer path from need to choice.</h2>
    </div>
    <ol class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
      <li class="rounded-card border border-line bg-canvas p-6">
        <span class="font-display text-3xl font-bold text-brand-700" aria-hidden="true">01</span>
        <h3 class="mt-4 text-lg font-bold text-ink">Describe the outcome</h3>
        <p class="mt-2 leading-7 text-muted">Begin in your own words with the problem you want to solve.</p>
      </li>
      <li class="rounded-card border border-line bg-canvas p-6">
        <span class="font-display text-3xl font-bold text-brand-700" aria-hidden="true">02</span>
        <h3 class="mt-4 text-lg font-bold text-ink">Make needs visible</h3>
        <p class="mt-2 leading-7 text-muted">Review the requirements that matter before comparing options.</p>
      </li>
      <li class="rounded-card border border-line bg-canvas p-6">
        <span class="font-display text-3xl font-bold text-brand-700" aria-hidden="true">03</span>
        <h3 class="mt-4 text-lg font-bold text-ink">Understand the tradeoffs</h3>
        <p class="mt-2 leading-7 text-muted">See why an option fits and where information is still unknown.</p>
      </li>
    </ol>
  </div>
</section>

<section id="our-approach" class="scroll-mt-24">
  <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-8 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8 lg:py-20">
    <div>
      <p class="text-sm font-bold uppercase tracking-widest text-brand-700">Our approach</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Useful guidance should stay inspectable.</h2>
    </div>
    <p class="text-lg leading-8 text-muted">
      Requirements, product evidence, and unknowns remain visible so you can make the final call with confidence.
    </p>
  </div>
</section>
