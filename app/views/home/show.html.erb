<% content_for :title, "Nudge" %>

<section class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
  <div class="max-w-2xl">
    <%= render "shared/badge", label: "Thoughtful shopping support", tone: :brand %>
    <h1 class="mt-5 font-display text-4xl font-bold leading-tight tracking-tight text-ink sm:text-5xl">
      Find what you need, by search or by voice.
    </h1>
    <p class="mt-4 max-w-xl text-lg leading-8 text-muted">
      Search the sample catalog directly below, or start voice shopping instead of typing.
    </p>
  </div>

  <div class="mt-8">
    <%= render "shared/catalog_search", query: nil %>
  </div>

  <div class="mt-10">
    <h2 class="font-display text-2xl font-bold tracking-tight text-ink">From the catalog</h2>

    <% if @catalog_unavailable %>
      <section class="mt-4 rounded-card border border-line bg-surface p-6 shadow-card sm:p-8">
        <h3 class="font-display text-xl font-bold text-ink">Sample catalog unavailable</h3>
        <p class="mt-2 text-muted">Please try browsing again later.</p>
      </section>
    <% elsif @catalog_page.items.any? %>
      <div class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        <%= render partial: "shared/catalog/product_card", collection: @catalog_page.items, as: :product %>
      </div>
      <div class="mt-6">
        <%= render "shared/button", label: "Browse the full catalog", href: products_path, variant: :secondary %>
      </div>
    <% else %>
      <section class="mt-4 rounded-card border border-line bg-surface p-6 shadow-card sm:p-8">
        <h3 class="font-display text-xl font-bold text-ink">No sample products yet</h3>
        <p class="mt-2 text-muted">Check back soon, or search the catalog above.</p>
      </section>
    <% end %>
  </div>
</section>

<section id="how-it-works" class="scroll-mt-24 border-t border-line bg-surface">
  <div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl font-bold tracking-tight text-ink">How it works</h2>
    <ol class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3">
      <li class="rounded-card border border-line bg-canvas p-5">
        <span class="font-display text-2xl font-bold text-brand-700" aria-hidden="true">01</span>
        <h3 class="mt-3 text-base font-bold text-ink">Search or talk</h3>
        <p class="mt-2 text-sm leading-6 text-muted">Type what you need above, or start voice shopping.</p>
      </li>
      <li class="rounded-card border border-line bg-canvas p-5">
        <span class="font-display text-2xl font-bold text-brand-700" aria-hidden="true">02</span>
        <h3 class="mt-3 text-base font-bold text-ink">See real options</h3>
        <p class="mt-2 text-sm leading-6 text-muted">Compare sample products with clear prices and availability.</p>
      </li>
      <li class="rounded-card border border-line bg-canvas p-5">
        <span class="font-display text-2xl font-bold text-brand-700" aria-hidden="true">03</span>
        <h3 class="mt-3 text-base font-bold text-ink">Decide with confidence</h3>
        <p class="mt-2 text-sm leading-6 text-muted">Details and tradeoffs stay visible while you choose.</p>
      </li>
    </ol>
  </div>
</section>
