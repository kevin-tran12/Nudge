<% content_for :title, "#{@product.title} | Sample catalog | Nudge" %>

<section class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
  <%= link_to "Back to catalog", products_path, class: "inline-flex min-h-11 min-w-11 items-center rounded-full px-4 text-sm font-bold text-brand-800 hover:bg-brand-50 focus:outline-none focus-visible:ring-4 focus-visible:ring-focus-ring focus-visible:ring-offset-2" %>

  <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2 lg:items-start">
    <%= render "shared/catalog/image_placeholder" %>

    <div class="min-w-0">
      <%= render "shared/badge", label: "Sample item", tone: :warning %>
      <h1 class="mt-4 break-words font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl"><%= @product.title %></h1>
      <div data-catalog-disclosure class="mt-6">
        <%= render "shared/notice", title: "Illustrative product", message: "This page uses sample fixture data. Prices and availability are illustrative and are not live supplier offers.", tone: :warning %>
      </div>
      <% if @product.sku.present? %><p class="mt-3 break-all text-sm font-semibold text-muted">Reference: <%= @product.sku %></p><% end %>
      <% if @product.description.present? %><p class="mt-5 break-words text-base leading-7 text-muted"><%= @product.description %></p><% end %>
      <% if @product.freshness.observed_at %>
        <p class="mt-5 text-sm text-muted">Catalog observation: <time datetime="<%= @product.freshness.observed_at.iso8601 %>"><%= @product.freshness.observed_at.utc.strftime("%B %-d, %Y at %H:%M UTC") %></time></p>
      <% else %>
        <p class="mt-5 text-sm text-muted">Catalog observation time unknown</p>
      <% end %>
    </div>
  </div>

  <div class="mt-8">
    <%= render "shared/voice_launcher" %>
  </div>

  <section aria-labelledby="variants-heading" class="mt-12">
    <h2 id="variants-heading" class="font-display text-3xl font-bold tracking-tight text-ink">Sample variants</h2>
    <div class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-2">
      <% @product.variants.each_with_index do |variant, index| %>
        <article class="min-w-0 rounded-card border border-line bg-surface p-5 shadow-card sm:p-6">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
              <h3 class="break-words text-xl font-bold text-ink"><%= variant.title.presence || "Variant #{index + 1}" %></h3>
              <% if variant.sku.present? %><p class="mt-1 break-all text-sm text-muted">Reference: <%= variant.sku %></p><% end %>
            </div>
            <%= render "shared/badge", label: variant.availability.state == :unknown ? "Unknown" : "Observed", tone: catalog_availability_tone(variant.availability) %>
          </div>

          <dl class="mt-5 grid grid-cols-1 gap-4 border-t border-line pt-5 sm:grid-cols-2">
            <div><dt class="text-xs font-bold uppercase tracking-wider text-muted">Price</dt><dd data-price-state="<%= variant.price.state %>" class="mt-1 font-semibold text-ink"><%= catalog_price_label(variant.price) %></dd></div>
            <div><dt class="text-xs font-bold uppercase tracking-wider text-muted">Availability</dt><dd data-availability-state="<%= variant.availability.state %>" class="mt-1 text-ink"><%= catalog_availability_label(variant.availability) %></dd></div>
            <div><dt class="text-xs font-bold uppercase tracking-wider text-muted">Weight</dt><dd class="mt-1 text-ink"><%= catalog_measurement(variant.weight) %></dd></div>
            <div><dt class="text-xs font-bold uppercase tracking-wider text-muted">Size</dt><dd class="mt-1 text-ink"><%= [variant.length, variant.width, variant.height].map { |measurement| catalog_measurement(measurement) }.join(" × ") %></dd></div>
          </dl>

          <%= form_with url: cart_items_path, method: :post, class: "mt-5" do %>
            <%= hidden_field_tag :catalog_product_id, @product.id %>
            <%= hidden_field_tag :catalog_variant_id, variant.id %>
            <%= hidden_field_tag :quantity, 1 %>
            <%= hidden_field_tag :client_mutation_id, SecureRandom.uuid %>
            <%= render "shared/button", label: "Add to cart", type: "submit", variant: :primary %>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>

  <div data-inventory-disclaimer class="mt-8">
    <%= render "shared/notice", title: "Inventory is not reserved", message: "Observed stock is not reserved, does not establish destination eligibility, and is not guaranteed. Price and availability must be confirmed before checkout and fulfillment.", tone: :warning %>
  </div>
</section>
