#!/usr/bin/env ruby

require "fileutils"

destination = ENV.fetch("SYSTEM_TEST_ARTIFACT_EXPORT", "/export")
sources = {
  "coverage" => "/source/coverage",
  "screenshots" => "/source/tmp/screenshots"
}

sources.each do |name, source|
  next unless Dir.exist?(source)

  target = File.join(destination, name)
  FileUtils.mkdir_p(target)

  Dir.glob(File.join(source, "{*,.*}"), File::FNM_EXTGLOB).each do |entry|
    next if %w[. ..].include?(File.basename(entry))

    FileUtils.cp_r(entry, target, remove_destination: true)
  end
end

puts "Exported browser-test artifacts to #{destination}"
