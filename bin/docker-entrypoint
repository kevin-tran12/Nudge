#!/usr/bin/env ruby

require "fileutils"

root = File.expand_path("..", __dir__)
writable_paths = %w[log storage tmp app/assets/builds].map { |path| File.join(root, path) }

abort "Refusing to run the Rails process as root" if Process.uid.zero?

if %w[development test].include?(ENV.fetch("RAILS_ENV", "development"))
  provider_modes = {
    "PROVIDER_MODE" => ENV.fetch("PROVIDER_MODE", "fixture"),
    "CJ_MODE" => ENV.fetch("CJ_MODE", "fixture")
  }
  unsafe_modes = provider_modes.reject { |_name, mode| mode == "fixture" }

  unless unsafe_modes.empty?
    abort "Local development and tests require fixture provider modes: #{unsafe_modes.keys.join(", ")}"
  end
end

writable_paths.each { |path| FileUtils.mkdir_p(path) }
FileUtils.rm_f(File.join(root, "tmp/pids/server.pid"))
exec(*ARGV)
